# Soft Landing — frontend environment variables (EXPO_PUBLIC_* only)
#
# Every variable here is embedded in the client bundle at build time, so it is
# PUBLIC by design. Never put a server-only secret (e.g. ANTHROPIC_API_KEY,
# RevenueCat *secret* API key, Firebase service-account key) in this file.
# The real values live in app-frontend/.env, which is gitignored.
# Copy this file to .env and fill in real values.

# ── Firebase (web config — public client identifiers) ───────────────────────
# From Firebase console → Project settings → Your apps → SDK setup & config.
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
# Optional — Google Analytics for Firebase measurement id (not required for V1).
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# ── Google Sign-In (OAuth client identifiers — public) ──────────────────────
# iOS client id: GoogleService-Info.plist CLIENT_ID. Its reversed form is the
# URL scheme declared in app.json.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
# Reversed iOS client id — used as the OAuth redirect URL scheme in app.json.
EXPO_PUBLIC_REVERSED_CLIENT_ID=com.googleusercontent.apps.YOUR_IOS_CLIENT_ID
# Web client id ("Web client (auto-created by Google Service)") — improves
# id_token reliability on native sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# ── RevenueCat (PUBLIC SDK keys — safe to ship, scope to bundle id in RC) ────
# From RevenueCat dashboard → Project → API keys → App-specific "public" keys.
# These are the public SDK keys (NOT the secret key). react-native-purchases
# picks the platform key at runtime in app-frontend/src/services/purchases.ts.
# Must be scoped to this app's bundle id in the RevenueCat dashboard.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=YOUR_REVENUECAT_IOS_PUBLIC_KEY_HERE
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=YOUR_REVENUECAT_ANDROID_PUBLIC_KEY_HERE

# ── Sentry (crash/error reporting — public DSN) ─────────────────────────────
# Optional. From Sentry → Project → Settings → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN_HERE
